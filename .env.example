# 이 파일을 복사해 .env 파일을 만들고 값을 채워 넣으세요.
#   cp .env.example .env

# Azure AI Vision (Azure Portal > Vision 리소스 > 키 및 엔드포인트)
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# 멀티모달 임베딩 모델 버전
VISION_MODEL_VERSION=2023-04-15

# Azure Blob Storage (참조 사진: curated 컨테이너/{place_id}/{파일})
# 키 없이 Azure 로그인으로 접속해요. 실행 전에 az login
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=curated

# PostgreSQL (place_image_embeddings 쓰기 권한이 있는 계정)
# 예: postgresql://<계정>:<비밀번호>@<서버>.postgres.database.azure.com:5432/<DB>?sslmode=require
DATABASE_URL=
